{
  "name": "forge-erp-server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch --env-file=../.env server.js",
    "start": "node --env-file-if-exists=../.env server.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1 tests/",
    "seed": "node --env-file=../.env scripts/seed.js",
    "db:roles": "node --env-file=../.env scripts/dbRoles.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "nodemailer": "^10.3.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^4.0.0"
  }
}
