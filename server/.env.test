# Test-only values. Nothing secret belongs here.
NODE_ENV=test
PORT=4199
MONGO_URI=mongodb://127.0.0.1:27017/forge-erp-test?replicaSet=rs0
JWT_ACCESS_SECRET=test-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=test-refresh-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
TRUST_PROXY=false

BACKUP_DIR=/tmp/forge-test-backups
BACKUP_KEEP=2
