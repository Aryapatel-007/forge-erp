# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4100
MONGO_URI=mongodb://127.0.0.1:27017/forge-erp?replicaSet=rs0
# Generate each with: openssl rand -base64 48. They must differ.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
# Proxies in front of the server, or false. Must be set in production. Never true.
TRUST_PROXY=false

# Optional. Without a mail server, emails wait in the queue and say so.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# Set to off on all but one server if you run several.
# SCHEDULER=on

# Where backups go. Move them off this machine, or they do not protect against losing it.
# BACKUP_DIR=
# BACKUP_KEEP=14

# A second place for backups, like another disk or a synced folder.
# BACKUP_COPY_DIR=

# Reading a mailbox, over TLS only. Mail stays on the server unless POP3_DELETE=true.
# POP3_HOST=
# POP3_PORT=995
# POP3_USER=
# POP3_PASSWORD=
# POP3_DELETE=false

# SMS: any provider that takes a JSON POST of to, message and sender.
# SMS_URL=
# SMS_TOKEN=
# SMS_SENDER=

# Daily exchange rates, as a guide. It is called with ?base=USD&symbols=INR.
# FX_RATE_URL=https://api.frankfurter.dev/v1/latest

# Payment links.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_BANK_ACCOUNT_CODE=
